  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  dialogueText: "Everything was normal that day, apart from hearing the news of Choi\u2019s
    death the following morning. Is there anything in particular you\u2019d like
    to know?"
  options:
  - optionText: Why are you staying at the office so late?
    nextNode: {fileID: 11400000, guid: fd9a0a23fdb8176428954b460b5e7f73, type: 2}
    nodeIdRequired: 
  - optionText: Why did you choose to take the bus home?
    nextNode: {fileID: 11400000, guid: 0b2f4f8be25a7804cb8a86992e32e5fb, type: 2}
    nodeIdRequired: 
  - optionText: Do you have an alibi for the entire time?
